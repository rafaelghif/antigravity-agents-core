{
  "mcpServers": {
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "--repository",
        "."
      ],
      "cwd": ".",
      "timeoutSeconds": 120
    },
    "gitea": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--env-file",
        ".agents/mcp.env",
        "gitea/gitea-mcp:v0.1.0"
      ],
      "cwd": ".",
      "timeoutSeconds": 180
    }
  }
}
