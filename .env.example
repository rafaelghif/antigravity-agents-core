# ==============================================================================
# Environment Configuration Template for Antigravity Agent Core
# ==============================================================================
# Copy this file to .env and configure values for your local environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env or raw credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Issue Tracker & Repository Integration
# ------------------------------------------------------------------------------
# Self-Hosted Gitea Configuration
GITEA_HOST=http://localhost:3000
GITEA_TOKEN=your_gitea_access_token_here

# GitHub Configuration (Personal Access Token with repo/issues scope)
GITHUB_PAT=your_github_personal_access_token_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# MCP Database Server Configuration (.agents/mcp_config.json)
# ------------------------------------------------------------------------------
# Shared database host and credentials for local/remote database instances
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=your_database_name_here

# Port overrides for specific database engines
DB_PORT_PG=5432
DB_PORT_MYSQL=3306
DB_PORT_MSSQL=1433
