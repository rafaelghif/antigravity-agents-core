{
  "name": "@rafaelghif/aac-core",
  "version": "5.3.1",
  "description": "Autonomous engineering framework for Google Antigravity",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "aac",
    "aac-core",
    "antigravity",
    "antigravity-agents-core",
    "google-antigravity",
    "agentic-ai",
    "gemini",
    "gemini-flash",
    "pair-programming",
    "mcp",
    "skills"
  ],
  "author": "Muhammad Rafael Ghifari <business.rafaelghifari@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/rafaelghif/antigravity-agents-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelghif/antigravity-agents-core.git"
  },
  "type": "module",
  "main": "bin/cli.mjs",
  "bin": {
    "aac-core": "bin/cli.mjs",
    "aac": "bin/cli.mjs"
  },
  "scripts": {
    "test": "node --test tests/memory-system.test.mjs tests/cli.test.mjs tests/lifecycle-guardrails-and-engines.test.mjs .agents/skills/caveman-explore/tests/skill-file.test.mjs .agents/skills/caveman-learn/tests/skill-file.test.mjs",
    "audit": "node bin/cli.mjs audit",
    "doctor": "node bin/cli.mjs doctor",
    "skills": "node bin/cli.mjs list",
    "scan": "node bin/cli.mjs scan",
    "quality": "node bin/cli.mjs quality",
    "review": "node bin/cli.mjs review",
    "analyze": "node bin/cli.mjs analyze",
    "tasks": "node bin/cli.mjs tasks",
    "memory": "node bin/cli.mjs memory"
  },
  "files": [
    "bin/",
    ".agents/",
    "!.agents/mcp_config.json",
    "!.agents/**/mcp_config.json",
    "!.agents/brain/**",
    "!.agents/inbox/**",
    "!.agents/harness/**",
    "!.agents/state/**",
    "!.agents/*settings*.json",
    "!**/*.pyc",
    "!**/__pycache__/**",
    "docs/",
    "AGENTS.md",
    "GEMINI.md",
    "CLAUDE.md",
    "CONTEXT.md",
    "skills-lock.json",
    ".env.example",
    "install.ps1",
    "install.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
